set timeout 45
log_user 1
set root_dir $env(ROOT_DIR)
set mode $env(SURFSMOKE_MODE)
set context $env(SURFSMOKE_CONTEXT)
set fixture $env(SURFSMOKE_FIXTURE)
set kubeconfig $env(KUBECONFIG_PATH)

spawn env TERM=xterm-256color COLUMNS=140 LINES=32 go run . -kubeconfig $kubeconfig -context $context
stty rows 32 columns 140

expect {
    -re "surfsk8s . select contexts" {}
    timeout { exit 2 }
}

if {$mode == "live"} {
    send -- "\r"
    expect {
        -re "surfsk8s . resource catalog" {}
        timeout { exit 3 }
    }

    send -- ":"
    after 300
    send -- "catalog"
    after 300
    send -- "\r"
    expect {
        -re "surfsk8s . resource catalog" {}
        timeout { exit 23 }
    }

    send -- "\r"
    expect {
        -re "surfsk8s . Favourites" {}
        timeout { exit 4 }
    }

    send -- "\r"
    expect {
        -re "surfsk8s . ns:.* . pods" {}
        timeout { exit 5 }
    }
    expect {
        -re "sort:default" {}
        timeout { exit 20 }
    }
    send -- "o"
    expect {
        -re "surfsk8s . add sort" {}
        timeout { exit 21 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . sort direction" {}
        timeout { exit 22 }
    }
    send -- "d"
    expect {
        -re "sort:.*↓" {}
        timeout { exit 52 }
    }
    send -- "O"
    expect {
        -re "surfsk8s . sorts" {}
        timeout { exit 53 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . pods" {}
        timeout { exit 54 }
    }
    send -- "/"
    after 300
    send -- "=kube-system coredns-"
    after 300
    send -- "\r"
    expect {
        -re "filter:=kube-system coredns-|surfsk8s . pods" {}
        timeout { exit 55 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . pod details" {}
        timeout { exit 56 }
    }
    send -- "l"
    expect {
        -re "surfsk8s . pod logs" {}
        timeout { exit 57 }
    }
    expect {
        -re {202[0-9]-[0-9][0-9]-[0-9][0-9]T} {}
        timeout { exit 58 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . pod details" {}
        timeout { exit 59 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . pods" {}
        timeout { exit 60 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . pods" {}
        timeout { exit 61 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . Favourites" {}
        timeout { exit 6 }
    }

    send -- "j\r"
    expect {
        -re "surfsk8s . ns:.* . deployments" {}
        timeout { exit 7 }
    }
    send -- "/"
    after 300
    send -- "=kube-system coredns"
    after 300
    send -- "\r"
    expect {
        -re "filter:=kube-system coredns|surfsk8s . deployments" {}
        timeout { exit 62 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . resource details" {}
        timeout { exit 63 }
    }
    send -- "l"
    expect {
        -re "surfsk8s . deployment logs" {}
        timeout { exit 64 }
    }
    expect {
        -re {202[0-9]-[0-9][0-9]-[0-9][0-9]T|\[coredns-} {}
        timeout { exit 65 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . resource details" {}
        timeout { exit 66 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . deployments" {}
        timeout { exit 67 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . deployments" {}
        timeout { exit 68 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . Favourites" {}
        timeout { exit 8 }
    }

    send -- "j"
    after 150
    send -- "j"
    after 150
    send -- "\r"
    expect {
        -re "surfsk8s . ns:.* . services" {}
        timeout { exit 9 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . Favourites" {}
        timeout { exit 10 }
    }

    send -- "j"
    after 150
    send -- "j"
    after 150
    send -- "j"
    after 150
    send -- "\r"
    expect {
        -re "surfsk8s . ns:.* . nodes" {}
        timeout { exit 11 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . resource details" {}
        timeout { exit 69 }
    }
    send -- "l"
    expect {
        -re "surfsk8s . select node log" {}
        timeout { exit 70 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . select node log" {}
        timeout { exit 71 }
    }
    send -- "\r"
    expect {
        -re "surfsk8s . node logs" {}
        timeout { exit 72 }
    }
    expect {
        -re {log|time=|INFO|WARN|ERROR|202[0-9]-} {}
        timeout { exit 75 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . resource details" {}
        timeout { exit 73 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . ns:.* . nodes" {}
        timeout { exit 74 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . Favourites" {}
        timeout { exit 12 }
    }

    send -- "\033"
    expect {
        -re "surfsk8s . resource catalog" {}
        timeout { exit 13 }
    }

    send -- "G\r"
    expect {
        -re "surfsk8s . CRDs" {}
        -re "surfsk8s . Cluster" {
            send -- "\033"
            expect {
                -re "surfsk8s . resource catalog" {}
                timeout { exit 14 }
            }
            after 2000
            send -- "G\r"
            exp_continue
        }
        timeout { exit 15 }
    }

    after 500
    send -- "/"
    after 300
    send -- "*service*serving.knative.dev*"
    after 300
    send -- "\r"
    expect {
        -re "filter:\*service\*serving.knative.dev\*|surfsk8s . CRDs|rows:1/134|services  \[CRD\]" {}
        timeout { exit 16 }
    }
    send -- "g\r"
    expect {
        -re "surfsk8s . ns:.* . services . serving.knative.dev" {}
        timeout { exit 17 }
    }
    expect {
        -re "LATESTCREATED" {}
        timeout { exit 18 }
    }
    send -- "\033"
    expect {
        -re "surfsk8s . CRDs" {}
        timeout { exit 19 }
    }

    if {$fixture == "true"} {
        send -- "\033"
        expect {
            -re "surfsk8s . resource catalog" {}
            timeout { exit 24 }
        }
        send -- "\r"
        expect {
            -re "surfsk8s . Favourites" {}
            timeout { exit 25 }
        }

        send -- "j\r"
        expect {
            -re "surfsk8s . deployments" {}
            timeout { exit 26 }
        }
        after 1000
        send -- "/"
        after 300
        send -- "=surfsk8s-smoke frontend"
        after 300
        send -- "\r"
        expect {
            -re "filter:=surfsk8s-smoke frontend|surfsk8s . deployments" {}
            timeout { exit 27 }
        }
        send -- "\r"
        expect {
            -re "surfsk8s . resource details" {}
            timeout { exit 28 }
        }
        send -- "y"
        expect {
            -re "surfsk8s . confirm action" {}
            timeout { exit 29 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . resource details" {}
            timeout { exit 30 }
        }
        send -- "s"
        expect {
            -re "replicas>" {}
            timeout { exit 31 }
        }
        send -- "\010"
        send -- "1"
        send -- "\r"
        expect {
            -re "surfsk8s . confirm action" {}
            timeout { exit 32 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . resource details" {}
            timeout { exit 33 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . deployments" {}
            timeout { exit 34 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . Favourites" {}
            timeout { exit 35 }
        }

        send -- "j\r"
        expect {
            -re "surfsk8s . services" {}
            timeout { exit 36 }
        }
        after 1000
        send -- "/"
        after 300
        send -- "=surfsk8s-smoke api"
        after 300
        send -- "\r"
        expect {
            -re "filter:=surfsk8s-smoke api|surfsk8s . services" {}
            timeout { exit 37 }
        }
        send -- "\r"
        expect {
            -re "surfsk8s . resource details" {}
            timeout { exit 38 }
        }
        send -- "p"
        expect {
            -re "surfsk8s . select service port" {}
            timeout { exit 39 }
        }
        send -- "\r"
        expect {
            -re "local-port>" {}
            timeout { exit 40 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . resource details" {}
            timeout { exit 41 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . services" {}
            timeout { exit 42 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . Favourites" {}
            timeout { exit 43 }
        }

        send -- "g\r"
        expect {
            -re "surfsk8s . pods" {}
            timeout { exit 44 }
        }
        after 1000
        send -- "/"
        after 300
        send -- "=surfsk8s-smoke toolbox"
        after 300
        send -- "\r"
        expect {
            -re "filter:=surfsk8s-smoke toolbox|surfsk8s . pods" {}
            timeout { exit 45 }
        }
        send -- "\r"
        expect {
            -re "surfsk8s . pod details" {}
            timeout { exit 46 }
        }
        send -- "x"
        expect {
            -re "surfsk8s . select container" {}
            timeout { exit 47 }
        }
        send -- "\033"
        expect {
            -re "surfsk8s . pod details" {}
            timeout { exit 48 }
        }
    }
}
send -- "q"
expect eof
